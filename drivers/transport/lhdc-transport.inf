[Version]
Signature="$WINDOWS NT$"
Class=Bluetooth
ClassGuid={e0cbf06c-cd8b-4647-bb8a-263b43f0f974}
Provider=%Provider%
DriverVer=10/19/2026,0.8.8.0
CatalogFile=lhdc-transport.cat
PnpLockdown=1

[Manufacturer]
%Provider%=Models,NTamd64.10.0...22621

[Models.NTamd64.10.0...22621]
; BthEnum never emits the private hardware ID; real devices match only the
; standard Audio Sink compatible ID, ranked below inbox hardware-ID matches.
; The installer binds one explicitly selected instance and probes LHDC V5.
%DeviceDesc%=Transport,LHDCWIN\SelectedAudioSink,BTHENUM\{0000110b-0000-1000-8000-00805f9b34fb}

[DestinationDirs]
DriverFiles=13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
lhdc-transport.sys=1

[Transport.NT]
CopyFiles=DriverFiles

[DriverFiles]
lhdc-transport.sys

[Transport.NT.HW]
AddReg=Security

[Security]
HKR,,Security,0x00000000,"D:P(A;;GA;;;SY)(A;;GA;;;BA)"

[Transport.NT.Services]
AddService=lhdc-transport,0x00000002,Service

[Service]
DisplayName=%DeviceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\lhdc-transport.sys

[Transport.NT.Wdf]
KmdfService=lhdc-transport,Wdf

[Wdf]
KmdfLibraryVersion=1.33

[Strings]
Provider="Windows LHDC Prototype"
DeviceDesc="LHDC V5 Bluetooth Audio Transport"
DiskName="Windows LHDC transport"
